{
  "name": "marklingo",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.1",
  "publisher": "zzgosh",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzgosh/marklingo.git"
  },
  "bugs": {
    "url": "https://github.com/zzgosh/marklingo/issues"
  },
  "homepage": "https://github.com/zzgosh/marklingo#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "translate",
    "translation",
    "ai",
    "openrouter",
    "i18n",
    "localization"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "marklingo.translateCurrentMarkdown",
        "title": "%commands.translateCurrentMarkdown.title%"
      },
      {
        "command": "marklingo.translateCurrentMarkdownFull",
        "title": "%commands.translateCurrentMarkdownFull.title%"
      },
      {
        "command": "marklingo.translateExplorerMarkdownFile",
        "title": "%commands.translateExplorerMarkdownFile.title%"
      },
      {
        "command": "marklingo.translateSelectedMarkdownResources",
        "title": "%commands.translateSelectedMarkdownResources.title%"
      },
      {
        "command": "marklingo.translateFolderMarkdown",
        "title": "%commands.translateFolderMarkdown.title%"
      },
      {
        "command": "marklingo.deleteCurrentProjectTranslatedFiles",
        "title": "%commands.deleteCurrentProjectTranslatedFiles.title%"
      },
      {
        "command": "marklingo.ignoreTranslatedFilesInGit",
        "title": "%commands.ignoreTranslatedFilesInGit.title%"
      },
      {
        "command": "marklingo.openSettings",
        "title": "%commands.openSettings.title%"
      }
    ],
    "keybindings": [
      {
        "command": "marklingo.translateCurrentMarkdown",
        "key": "ctrl+alt+t",
        "mac": "alt+cmd+t",
        "win": "ctrl+alt+t",
        "linux": "ctrl+alt+t",
        "when": "editorTextFocus && (editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown)"
      },
      {
        "command": "marklingo.deleteCurrentProjectTranslatedFiles",
        "key": "ctrl+alt+d",
        "mac": "alt+cmd+d",
        "win": "ctrl+alt+d",
        "linux": "ctrl+alt+d",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "marklingo.translateCurrentMarkdown",
          "when": "!(resourceFilename =~ /_mdt[.](md|markdown)$/i) && (editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown)",
          "group": "marklingo@10"
        }
      ],
      "explorer/context": [
        {
          "command": "marklingo.translateExplorerMarkdownFile",
          "when": "!listMultiSelection && !explorerResourceIsFolder && isFileSystemResource && !(resourceFilename =~ /_mdt[.](md|markdown)$/i) && (resourceExtname == .md || resourceExtname == .markdown)",
          "group": "marklingo@10"
        },
        {
          "command": "marklingo.translateSelectedMarkdownResources",
          "when": "listMultiSelection && isFileSystemResource && !(resourceFilename =~ /_mdt[.](md|markdown)$/i) && (explorerResourceIsFolder || resourceExtname == .md || resourceExtname == .markdown)",
          "group": "marklingo@10"
        },
        {
          "command": "marklingo.translateFolderMarkdown",
          "when": "!listMultiSelection && explorerResourceIsFolder && isFileSystemResource",
          "group": "marklingo@11"
        }
      ],
      "commandPalette": [
        {
          "command": "marklingo.translateExplorerMarkdownFile",
          "when": "false"
        },
        {
          "command": "marklingo.translateSelectedMarkdownResources",
          "when": "false"
        },
        {
          "command": "marklingo.translateFolderMarkdown",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "marklingo.openrouter.provider": {
          "type": "string",
          "default": "openrouter",
          "enum": [
            "openrouter",
            "openai",
            "deepseek",
            "moonshot",
            "glm",
            "xiaomiMimo",
            "openaiCompatible"
          ],
          "enumDescriptions": [
            "%configuration.openrouter.provider.enumDescription.openrouter%",
            "%configuration.openrouter.provider.enumDescription.openai%",
            "%configuration.openrouter.provider.enumDescription.deepseek%",
            "%configuration.openrouter.provider.enumDescription.moonshot%",
            "%configuration.openrouter.provider.enumDescription.glm%",
            "%configuration.openrouter.provider.enumDescription.xiaomiMimo%",
            "%configuration.openrouter.provider.enumDescription.openaiCompatible%"
          ],
          "description": "%configuration.openrouter.provider.description%"
        },
        "marklingo.openrouter.baseUrl": {
          "type": "string",
          "scope": "application",
          "default": "https://openrouter.ai/api/v1",
          "description": "%configuration.openrouter.baseUrl.description%"
        },
        "marklingo.openrouter.modelId": {
          "type": "string",
          "default": "google/gemini-3.1-flash-lite",
          "description": "%configuration.openrouter.modelId.description%"
        },
        "marklingo.providers.openrouter.modelId": {
          "type": "string",
          "default": "google/gemini-3.1-flash-lite",
          "description": "%configuration.providers.openrouter.modelId.description%"
        },
        "marklingo.providers.openai.modelId": {
          "type": "string",
          "default": "",
          "description": "%configuration.providers.openai.modelId.description%"
        },
        "marklingo.providers.deepseek.modelId": {
          "type": "string",
          "default": "",
          "description": "%configuration.providers.deepseek.modelId.description%"
        },
        "marklingo.providers.moonshot.modelId": {
          "type": "string",
          "default": "",
          "description": "%configuration.providers.moonshot.modelId.description%"
        },
        "marklingo.providers.glm.modelId": {
          "type": "string",
          "default": "",
          "description": "%configuration.providers.glm.modelId.description%"
        },
        "marklingo.providers.xiaomiMimo.modelId": {
          "type": "string",
          "default": "",
          "description": "%configuration.providers.xiaomiMimo.modelId.description%"
        },
        "marklingo.providers.openaiCompatible.baseUrl": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "%configuration.providers.openaiCompatible.baseUrl.description%"
        },
        "marklingo.providers.openaiCompatible.modelId": {
          "type": "string",
          "default": "",
          "description": "%configuration.providers.openaiCompatible.modelId.description%"
        },
        "marklingo.translation.maxBlocksPerRequest": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "description": "%configuration.translation.maxBlocksPerRequest.description%"
        },
        "marklingo.translation.maxContextUsageRatio": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "maximum": 0.9,
          "description": "%configuration.translation.maxContextUsageRatio.description%"
        },
        "marklingo.translation.requestMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "chatJson",
            "translationModel"
          ],
          "enumDescriptions": [
            "%configuration.translation.requestMode.enumDescription.auto%",
            "%configuration.translation.requestMode.enumDescription.chatJson%",
            "%configuration.translation.requestMode.enumDescription.translationModel%"
          ],
          "description": "%configuration.translation.requestMode.description%"
        },
        "marklingo.translation.translationModelMaxBlocksPerRequest": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 24,
          "description": "%configuration.translation.translationModelMaxBlocksPerRequest.description%"
        },
        "marklingo.translation.translationModelConcurrency": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 4,
          "description": "%configuration.translation.translationModelConcurrency.description%"
        },
        "marklingo.translation.translationModelMaxOutputTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32768,
          "description": "%configuration.translation.translationModelMaxOutputTokens.description%"
        },
        "marklingo.translation.targetLanguage": {
          "type": "string",
          "default": "简体中文",
          "enum": [
            "简体中文",
            "繁体中文",
            "English",
            "日本語",
            "한국어",
            "Français",
            "Español",
            "Deutsch",
            "Custom..."
          ],
          "description": "%configuration.translation.targetLanguage.description%"
        },
        "marklingo.translation.targetLanguageCustom": {
          "type": "string",
          "default": "",
          "description": "%configuration.translation.targetLanguageCustom.description%"
        },
        "marklingo.translation.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "%configuration.translation.systemPrompt.description%"
        },
        "marklingo.translation.customPrompt": {
          "type": "string",
          "default": "",
          "description": "%configuration.translation.customPrompt.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "esbuild ./out/extension.js --bundle --platform=node --format=esm --external:vscode --sourcemap --outfile=dist/extension.js",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "test:vscode": "npm run package && node scripts/run-vscode-tests.mjs",
    "test:vscode:clean": "rm -rf .vscode-test && npm run test:vscode",
    "check:integration": "npm run check && npm run test:vscode",
    "check": "npm run compile && npm test",
    "benchmark:postprocessing": "npm run compile && node scripts/benchmark-postprocessing.mjs",
    "sync:model-pricing": "npm run compile && node scripts/sync-model-pricing.mjs",
    "preview:settings": "node scripts/preview-settings.mjs",
    "dev:vscode": "npm run package && node scripts/open-vscode-dev.mjs",
    "package": "npm run compile && npm run bundle",
    "package:dry": "npm run package && npx --no-install vsce ls --tree",
    "vsix": "npm run check && npx --no-install vsce package",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0",
    "ovsx": "^1.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  }
}
